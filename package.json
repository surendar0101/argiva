{
  "name": "argiva",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && node --test \"scripts/*.test.mjs\"",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter=@argiva/web",
    "tokens:build": "pnpm --filter @argiva/design-tokens build",
    "tokens:check": "pnpm --filter @argiva/design-tokens validate",
    "tokens:new": "pnpm --filter @argiva/design-tokens new-theme",
    "ui:test": "pnpm --filter @argiva/ui test",
    "ui:typecheck": "pnpm --filter @argiva/ui typecheck",
    "ui:preview": "pnpm --filter @argiva/ui-preview dev",
    "ui:preview:build": "pnpm --filter @argiva/ui-preview build",
    "lint": "eslint . && pnpm run lint:no-hex && pnpm run lint:hardcoded",
    "lint:no-hex": "node scripts/check-no-hex.mjs packages/ui/src apps/ui-preview/src apps/web/src",
    "lint:hardcoded": "node scripts/check-hardcoded.mjs apps/web/src packages/ui/src packages/config/src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
